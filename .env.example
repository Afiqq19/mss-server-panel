# =================================================================
# MSS-SERVER-PANEL (SERNEL) - ROOT ENVIRONMENT CONFIGURATION
# =================================================================

APP_NAME="MSS-Server-Panel"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
DEPLOY_SECRET=kunci-rahasia-mepal-2026

# Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_EXTERNAL_PORT=3306

# Database Configuration (Docker MySQL or Laragon)
# Note: In Docker compose, host is 'mss-db'. For local Laragon, host is '127.0.0.1'
DB_CONNECTION=mysql
DB_HOST=mss-db
DB_PORT=3306
DB_DATABASE=mss_panel
DB_USERNAME=mss_user
DB_PASSWORD=mss_secret_pass
DB_ROOT_PASSWORD=root_secret_pass

# =================================================================
# PORTAINER API CONFIGURATION (Bab 1, 2, 4)
# =================================================================
PORTAINER_URL=http://localhost:9000
PORTAINER_API_KEY=ptr_your_portainer_access_token_here
PORTAINER_ENDPOINT_ID=1

# =================================================================
# VPS HOST MONITORING & HARDWARE PATHS (Bab 4, 9.A)
# =================================================================
# On Linux host, these point to /proc and /sys.
HOST_PROC_PATH=/host/proc
HOST_SYS_PATH=/host/sys

# =================================================================
# NEXTCLOUD NAS & BACKUP CONFIGURATION (Bab 9.B)
# =================================================================
# Directory on Host machine where Nextcloud stores SQL backup files
NEXTCLOUD_HOST_BACKUP_DIR=/var/lib/docker/volumes/nas-mss_nextcloud_data/_data/data/mss/files/Backup-Server
# Path mounted inside container
NEXTCLOUD_BACKUP_PATH=/host/backup-server

# Directory on Host containing backup script
BACKUP_HOST_SCRIPT_DIR=/home/mss/backup-otomatis
# Full script path inside container / host
BACKUP_SCRIPT_PATH=/host/backup-scripts/jalankan-backup.sh
